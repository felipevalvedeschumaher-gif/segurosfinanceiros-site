---
import Layout from "../layouts/Layout.astro";
import { ordenadas, dataBR } from "../data/materias.js";
const lista = ordenadas();
const temas = ["Seguro Garantia Judicial e depósito recursal", "Seguro Garantia em licitações e contratos", "Seguro de Crédito", "Prestamista Imobiliário (CNSP 447)", "RC, D&O e E&O"];
---
<Layout title="Matérias | Seguros Financeiros" description="Matérias e análises da Seguros Financeiros sobre Seguro Garantia, Seguro de Crédito, Prestamista Imobiliário e Seguros de Responsabilidade para empresas.">
  <main id="page-materias">
    <section class="relative bg-executive-grid text-white py-16 sm:py-20 border-b border-white/10">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-5">
        <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-gold-500/10 border border-gold-500/30 text-gold-300 text-xs sm:text-sm font-semibold tracking-wide">
          <i data-lucide="book-open" class="w-4 h-4"></i>
          Conteúdo para CFOs, tesoureiros e jurídico
        </span>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight leading-[1.15] max-w-3xl">
          Matérias e análises sobre <span class="gold-gradient-text">seguros financeiros</span>
        </h1>
        <p class="text-base sm:text-lg text-slate-300 leading-relaxed max-w-2xl">
          Conteúdo técnico e objetivo para apoiar decisões sobre garantias, crédito e proteção do balanço da sua empresa.
        </p>
      </div>
    </section>

    <section class="py-16 sm:py-20 bg-slate-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        {lista.length > 0 ? (
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {lista.map((m) => (
              <a href={`/materias/${m.slug}`} class="group bg-white rounded-2xl border border-slate-200 shadow-executive p-6 flex flex-col gap-3 hover:border-gold-500/50 transition">
                <span class="text-[11px] uppercase tracking-widest text-gold-600 font-bold">{m.categoria}</span>
                <h2 class="text-lg font-extrabold text-navy-900 leading-snug group-hover:text-gold-600 transition">{m.titulo}</h2>
                <p class="text-sm text-slate-600 leading-relaxed flex-1">{m.resumo}</p>
                <div class="flex items-center justify-between text-xs text-slate-500 pt-3 border-t border-slate-100">
                  <span>{dataBR(m.data)}{m.leitura ? ` • ${m.leitura}` : ""}</span>
                  <span class="inline-flex items-center gap-1 font-semibold text-navy-800">Ler matéria <i data-lucide="arrow-right" class="w-3.5 h-3.5"></i></span>
                </div>
              </a>
            ))}
          </div>
        ) : (
          <div class="max-w-3xl mx-auto bg-white rounded-3xl border border-slate-200 shadow-executive p-8 sm:p-12 text-center space-y-5">
            <div class="w-14 h-14 mx-auto rounded-2xl bg-gold-100 border border-gold-500/30 flex items-center justify-center text-gold-600">
              <i data-lucide="pen-line" class="w-7 h-7"></i>
            </div>
            <span class="block text-xs font-bold uppercase tracking-[0.2em] text-gold-600">Em breve</span>
            <h2 class="text-2xl sm:text-3xl font-extrabold text-navy-900 tracking-tight">Nossas primeiras matérias estão em preparação</h2>
            <p class="text-slate-600 leading-relaxed">
              Em breve, publicaremos aqui análises sobre os temas que mais impactam o caixa e o risco das empresas. Enquanto isso, fale com um especialista para tirar dúvidas sobre o seu caso.
            </p>
            <ul class="flex flex-wrap justify-center gap-2 pt-1">
              {temas.map((t) => (
                <li class="px-3 py-1.5 rounded-full bg-slate-50 border border-slate-200 text-xs font-semibold text-navy-800">{t}</li>
              ))}
            </ul>
            <div class="pt-3 flex flex-col sm:flex-row items-center justify-center gap-3">
              <button onclick="openContactModal('Dúvida sobre seguros financeiros - Matérias')" class="gold-gradient-btn text-navy-950 font-bold text-sm px-6 py-3.5 rounded-xl inline-flex items-center gap-2 shadow-gold">
                <span>Falar com um especialista</span>
                <i data-lucide="arrow-right" class="w-4 h-4"></i>
              </button>
              <a href="/#deposito-recursal" class="px-6 py-3.5 rounded-xl bg-navy-900 hover:bg-navy-800 text-white font-semibold text-sm inline-flex items-center gap-2 transition">
                <i data-lucide="gavel" class="w-4 h-4 text-gold-400"></i>
                <span>Seguro para depósito recursal</span>
              </a>
            </div>
          </div>
        )}
      </div>
    </section>
  </main>
</Layout>
